{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://taskflow.dev/schemas/skill-registry-v1.schema.json",
  "type": "object",
  "required": ["apiVersion", "registryId", "generation", "artifacts"],
  "properties": {
    "apiVersion": {"const": "agent.taskflow/skill-registry/v1"},
    "registryId": {"type": "string", "minLength": 1},
    "generation": {"type": "integer", "minimum": 0},
    "artifacts": {"type": "array", "items": {"type": "object", "required": ["packageId", "version", "digest", "size", "mirrors", "signatureUri"], "properties": {"packageId": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}, "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "size": {"type": "integer", "minimum": 1, "maximum": 536870912}, "mirrors": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "signatureUri": {"type": "string", "minLength": 1}}, "additionalProperties": false}}
  },
  "additionalProperties": false
}
