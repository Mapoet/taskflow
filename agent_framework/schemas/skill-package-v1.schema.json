{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://taskflow.dev/schemas/skill-package-v1.schema.json",
  "type": "object",
  "required": ["apiVersion", "packageId", "packageVersion", "archiveDigest", "sbomDigest", "provenanceDigest", "entryCount"],
  "properties": {
    "apiVersion": {"const": "agent.taskflow/skill-package/v1"},
    "packageId": {"type": "string", "minLength": 1},
    "packageVersion": {"type": "string", "minLength": 1},
    "archiveDigest": {"$ref": "#/$defs/sha256"},
    "sbomDigest": {"$ref": "#/$defs/sha256"},
    "provenanceDigest": {"$ref": "#/$defs/sha256"},
    "entryCount": {"type": "integer", "minimum": 1, "maximum": 4096}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
  "additionalProperties": false
}
