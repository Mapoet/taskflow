{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://taskflow.dev/schemas/skill-signature-v1.schema.json",
  "type": "object",
  "required": ["apiVersion", "algorithm", "subjectKind", "subjectDigest", "keyId", "publisher", "sourceUri", "sbomDigest", "provenanceDigest", "signature"],
  "properties": {
    "apiVersion": {"const": "agent.taskflow/skill-signature/v1"},
    "algorithm": {"const": "Ed25519"},
    "subjectKind": {"enum": ["package", "registry"]},
    "subjectDigest": {"$ref": "#/$defs/sha256"},
    "keyId": {"$ref": "#/$defs/sha256"},
    "publisher": {"type": "string", "minLength": 1},
    "sourceUri": {"type": "string", "minLength": 1},
    "sbomDigest": {"$ref": "#/$defs/sha256"},
    "provenanceDigest": {"$ref": "#/$defs/sha256"},
    "signature": {"type": "string", "minLength": 1, "maxLength": 1024}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
  "additionalProperties": false
}
