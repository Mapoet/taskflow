{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://taskflow.dev/schemas/agent/skill-manifest-v1.schema.json",
  "title": "Agent Framework Skill Manifest v1",
  "type": "object",
  "required": ["api-version", "kind", "name", "version", "description"],
  "properties": {
    "api-version": {"const": "agent.taskflow/v1"},
    "kind": {"const": "Skill"},
    "name": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{1,128}$"},
    "version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$"},
    "description": {"type": "string"},
    "license": {"type": "string"},
    "authors": {"type": "array", "items": {"type": "string"}},
    "dependencies": {"type": "array", "items": {"$ref": "#/$defs/dependency"}},
    "permissions": {"$ref": "#/$defs/permissions"},
    "resources": {"$ref": "#/$defs/resources"},
    "tests": {"type": "array", "items": {"$ref": "#/$defs/resource"}}
  },
  "additionalProperties": true,
  "$defs": {
    "string-list": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "dependency": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{1,128}$"},
        "version": {"type": "string", "minLength": 1},
        "optional": {"type": "boolean", "default": false}
      },
      "additionalProperties": false
    },
    "permissions": {
      "type": "object",
      "properties": {
        "tools": {"$ref": "#/$defs/string-list"},
        "network": {"$ref": "#/$defs/string-list"},
        "env": {"$ref": "#/$defs/string-list"},
        "secrets": {"$ref": "#/$defs/string-list"},
        "filesystem": {
          "type": "object",
          "properties": {
            "read": {"$ref": "#/$defs/string-list"},
            "write": {"$ref": "#/$defs/string-list"}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "citation": {
      "type": "object",
      "required": ["title"],
      "properties": {
        "title": {"type": "string", "minLength": 1},
        "authors": {"$ref": "#/$defs/string-list"},
        "published": {"type": "string"},
        "url": {"type": "string"},
        "locator": {"type": "string"}
      },
      "additionalProperties": false
    },
    "reference-index": {
      "type": "object",
      "required": ["kind"],
      "properties": {"kind": {"const": "lexical-v1"}},
      "additionalProperties": false
    },
    "model-requirements": {
      "type": "object",
      "required": ["devices", "precisions", "min-memory-bytes"],
      "properties": {
        "devices": {"$ref": "#/$defs/string-list", "minItems": 1},
        "precisions": {"$ref": "#/$defs/string-list", "minItems": 1},
        "min-memory-bytes": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "resource-object": {
      "type": "object",
      "required": ["path"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{1,128}$"},
        "path": {"type": "string", "minLength": 1},
        "media-type": {"type": "string"},
        "read-mode": {"enum": ["auto", "text", "binary", "stream", "mmap"]},
        "sha256": {"type": "string", "pattern": "^[0-9A-Fa-f]{64}$"},
        "size": {"type": "integer", "minimum": 0},
        "size-limit": {"type": "integer", "minimum": 0},
        "license": {"type": "string", "minLength": 1, "maxLength": 256},
        "source": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9+.-]*://\\S+$"},
        "optional": {"type": "boolean", "default": false},
        "executable": {"type": "boolean", "default": false},
        "input-schema": {"type": "string"},
        "output-schema": {"type": "string"},
        "runtime": {"type": "string"},
        "permissions": {"$ref": "#/$defs/permissions"},
        "depends-on": {"$ref": "#/$defs/string-list"},
        "cache-policy": {"enum": ["no-store", "on-demand", "pin"]},
        "citation": {"$ref": "#/$defs/citation"},
        "index": {"$ref": "#/$defs/reference-index"},
        "requirements": {"$ref": "#/$defs/model-requirements"}
      },
      "additionalProperties": false
    },
    "resource": {
      "oneOf": [
        {"type": "string", "minLength": 1},
        {"$ref": "#/$defs/resource-object"}
      ]
    },
    "artifact-resource": {
      "allOf": [
        {"$ref": "#/$defs/resource-object"},
        {"required": ["path", "sha256", "size", "license", "source"]}
      ]
    },
    "model-resource": {
      "allOf": [
        {"$ref": "#/$defs/artifact-resource"},
        {"required": ["runtime", "requirements"], "properties": {"executable": {"const": false}}}
      ]
    },
    "resource-list": {"type": "array", "items": {"$ref": "#/$defs/resource"}},
    "artifact-resource-list": {"type": "array", "items": {"$ref": "#/$defs/artifact-resource"}},
    "model-resource-list": {"type": "array", "items": {"$ref": "#/$defs/model-resource"}},
    "resources": {
      "type": "object",
      "properties": {
        "scripts": {"$ref": "#/$defs/resource-list"},
        "cli": {"$ref": "#/$defs/resource-list"},
        "references": {"$ref": "#/$defs/resource-list"},
        "tools": {"$ref": "#/$defs/resource-list"},
        "mcp": {"$ref": "#/$defs/resource-list"},
        "templates": {"$ref": "#/$defs/resource-list"},
        "schemas": {"$ref": "#/$defs/resource-list"},
        "prompts": {"$ref": "#/$defs/resource-list"},
        "workflows": {"$ref": "#/$defs/resource-list"},
        "configs": {"$ref": "#/$defs/resource-list"},
        "assets": {"$ref": "#/$defs/artifact-resource-list"},
        "models": {"$ref": "#/$defs/model-resource-list"},
        "tests": {"$ref": "#/$defs/resource-list"}
      },
      "additionalProperties": false
    }
  }
}
