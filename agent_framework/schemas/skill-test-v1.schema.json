{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://taskflow.github.io/agent-framework/schemas/skill-test-v1.schema.json",
  "title": "Skill Test v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "name", "target", "expect"],
  "properties": {
    "apiVersion": {"const": "agent.taskflow/skill-test/v1"},
    "kind": {"const": "SkillTest"},
    "name": {"type": "string", "minLength": 1},
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "resource"],
      "properties": {
        "kind": {"enum": ["resource", "tool", "workflow", "script", "cli"]},
        "resource": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*\\.\\.)(?!.*\\\\).+$"}
      }
    },
    "input": {},
    "mocks": {
      "type": "object",
      "additionalProperties": false,
      "properties": {"tools": {"type": "object"}}
    },
    "expect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok"],
      "properties": {
        "ok": {"type": "boolean"}, "output": {}, "error": {},
        "events": {"type": "array"}, "stdout": {"type": "string"},
        "stderr": {"type": "string"}, "exitCode": {"type": "integer"},
        "resourceDigests": {"type": "object"}
      }
    }
  }
}
