# Copy to repository-root .env.server. It shares all provider/tool keys with ui.env.example.
AGENT_LLM_PROVIDER=openai
AGENT_OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_API_KEY=
AGENT_LLM_MODEL=deepseek-chat

# Live AgentServer defaults (the launcher also applies these when absent).
AGENT_VERIFIER=on
AGENT_WEB_ENABLE=1
AGENT_EXPR_ENABLE=1
AGENT_DRAW_ENABLE=1
AGENT_SKILL_INJECT_CATALOG=1
AGENT_SERVER_BIND=127.0.0.1
AGENT_SERVER_PORT=8080
AGENT_SERVER_JSON_RPC_PATH=/rpc
AGENT_SERVER_SESSION=memory

# Security controls: set a narrow FS jail, optional allowlist, and optionally Bearer auth.
AGENT_FS_ROOT=/absolute/path/to/workspace
AGENT_TOOL_ALLOWLIST=
AGENT_SERVER_AUTH_TOKEN=
AGENT_MCP_SKIP_SERVICES=
