# Copy this trusted shell environment file to the repository root as .env.ui.
# Never commit the resulting .env.ui file or a real API key.

# DeepSeek (OpenAI-compatible) example:
AGENT_LLM_PROVIDER=openai
AGENT_OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_API_KEY=
AGENT_LLM_MODEL=deepseek-chat

# For OpenAI, use https://api.openai.com/v1 and an OpenAI model.
# For Anthropic, set AGENT_LLM_PROVIDER=anthropic and ANTHROPIC_API_KEY.

# Full built-in tool set. The launcher defaults these switches to 1.
AGENT_WEB_ENABLE=1
AGENT_EXPR_ENABLE=1
AGENT_DRAW_ENABLE=1
AGENT_SKILL_INJECT_CATALOG=1

# FS tools are jailed to --fs-root (default: agent_framework/tools).
# AGENT_FS_MAX_READ_BYTES=1048576
# AGENT_FS_MAX_WRITE_BYTES=1048576

# Optional outbound restrictions. HTTP stays disabled unless explicitly enabled.
# AGENT_WEB_ALLOW_HOSTS=example.com,api.example.com
# AGENT_WEB_ALLOW_HTTP=1

# Optional single Skills root. When unset, all UIs discover Cursor's two roots.
# AGENT_SKILLS_DIR=/absolute/path/to/skills

# Skill scripts remain denied unless trusted interpreter paths are explicitly listed.
# AGENT_SKILL_SCRIPT_ALLOWLIST=/bin/bash,/usr/bin/python3

# Optional explicit Cursor MCP configuration and per-service request timeout.
# AGENT_TEST_CURSOR_MCP_JSON=/home/user/.cursor/mcp.json
# AGENT_MCP_REQUEST_TIMEOUT_MS=60000
# Comma-separated services to leave disabled without suppressing healthy MCP servers.
# AGENT_MCP_SKIP_SERVICES=python_execute
# cursor-mcp-safe.example.json supports ${AGENT_FS_ROOT} in stdio args and uses the
# installed Google Chrome for Playwright. The Python example requires a running
# Streamable HTTP server at /mcp; legacy /sse endpoints are not interchangeable.
